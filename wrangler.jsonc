{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "orbis-portal",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "account_id": "d368028981eb36694bcf42848721826a",
  "assets": { "directory": "./frontend/dist", "binding": "ASSETS", "not_found_handling": "single-page-application" },
  "d1_databases": [{ "binding": "DB", "database_name": "orbis_db", "database_id": "local-dev", "migrations_dir": "migrations" }],
  "r2_buckets": [{ "binding": "DOCS", "bucket_name": "orbis-docs" }],
  "vars": { "ALLOWED_ORIGIN": "http://localhost:8787" },
  "env": {
    "staging": {
      "name": "orbis-portal-staging",
      "vars": { "ALLOWED_ORIGIN": "https://orbis-portal-staging.orbis-d36.workers.dev" },
      "d1_databases": [
        { "binding": "DB", "database_name": "orbis_db_staging", "database_id": "501b88c2-62a4-4e88-97f7-5f5c9e417580", "migrations_dir": "migrations" }
      ],
      "r2_buckets": [{ "binding": "DOCS", "bucket_name": "orbis-docs-staging" }]
    }
  }
}
